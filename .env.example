# Copy to .env.local and fill in. Never commit real values.
# M0 only needs NEXT_PUBLIC_SITE_URL; the rest are wired in later milestones.

# --- Site (M0) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- CMS: Sanity (M1c) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# --- Contact form: anti-spam (M1d) ---
# Cloudflare Turnstile. Leave both empty to disable (honeypot + rate limit still apply).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis for rate limiting across serverless instances (5 submissions / IP / hour).
# Without it, a per-instance in-memory limit is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Contact form: lead delivery (M1d) ---
# A lead counts as sent only if at least ONE of HubSpot / Slack / notification email accepts
# it. In production with none configured, the form tells the visitor it didn't send.
# HubSpot Forms API (private app token with "forms" scope; see README "Integrations").
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=
# Slack incoming webhook for #new-leads.
SLACK_LEADS_WEBHOOK_URL=
# Resend: team notification (a delivery channel) + visitor confirmation (best-effort).
RESEND_API_KEY=
# A named person, not noreply, on a domain verified in Resend.
LEADS_FROM_EMAIL="Maya at Akrostech <maya@akrosstech.com>"
# Team inbox for new-lead notifications (also the reply-to on visitor confirmations).
LEADS_NOTIFY_EMAIL=
# Development / E2E only: log leads to the server console and count that as delivered.
# NEVER set this in production.
LEADS_LOG_ONLY=

# --- Scheduling (optional) ---
# Shows "Prefer to pick a time now? Book directly" on /contact, e.g. akrostech/scoping-call
NEXT_PUBLIC_CAL_LINK=
CAL_API_KEY=

# --- Careers: ATS job board (M2c) ---
# Open roles on /careers come from your ATS's public job-board API (read-only, no key).
# ATS_PROVIDER: ashby | greenhouse | lever
# ATS_BOARD: Ashby job board name, Greenhouse board token, or Lever site name.
# Leave empty to show the "No open roles" talent-pool state. Roles refresh hourly.
ATS_PROVIDER=
ATS_BOARD=
# "Join the talent pool": your ATS's general application URL (https). Empty = email link.
NEXT_PUBLIC_TALENT_POOL_URL=

# --- Analytics & monitoring (M4c) ---
# PostHog: loaded only after a visitor chooses "Allow" (Global Privacy Control = no),
# with no cookies, autocapture, replay or remote scripts. Empty = no banner, no analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server errors (renders, route handlers, actions, proxy) to Sentry. Empty = off.
SENTRY_DSN=

# --- Newsletter (M5a footer) ---
# HubSpot form that records newsletter sign-ups (uses the HubSpot token + portal above).
# Empty = the footer shows no newsletter form at all.
HUBSPOT_NEWSLETTER_FORM_ID=

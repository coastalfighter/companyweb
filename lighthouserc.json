{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- --port 3200",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3200/",
        "http://localhost:3200/services",
        "http://localhost:3200/services/accounting",
        "http://localhost:3200/contact",
        "http://localhost:3200/about",
        "http://localhost:3200/how-it-works",
        "http://localhost:3200/work",
        "http://localhost:3200/careers"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 1800
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 150
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 240000
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 600000
          }
        ],
        "resource-summary:third-party:count": [
          "error",
          {
            "maxNumericValue": 0
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
